{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": [
    "node_modules",
    "RAG_Basics",
    "job-tracker",
    "QABuddy.ai",
    "Chaptor_02",
    "allure-report",
    "playwright-report",
    "tta-report",
    "test-results",
    "reports"
  ]
}
