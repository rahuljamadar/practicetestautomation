      "parameters": {
        "jsCode": "const input = $json ?? {};\nconst decision = String(input.Decision ?? '').trim();\nconst reviewer = String(input['Reviewer Name'] ?? '').trim();\nconst feedback = String(input['Review Feedback'] ?? '').trim();\nreturn [{\n  json: {\n    workflow: 'QA Orchestrator',\n    status: 'APPROVED',\n    completedAt: new Date().toISOString(),\n    reviewer,\n    approvalDecision: decision || 'Approved',\n    automationPackage: input.output ?? input,\n    reviewFeedback: feedback,\n    message: 'QA workflow completed successfully. The approved package is ready for human-reviewed implementation.'\n  }\n}];"
