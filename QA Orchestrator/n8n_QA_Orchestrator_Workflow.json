      "parameters": {
        "jsCode": "const input = $json ?? {};\nconst decision = String(input.Decision ?? '').trim();\nconst reviewer = String(input['Reviewer Name'] ?? '').trim();\nconst feedback = String(input['Review Feedback'] ?? '').trim();\nreturn [{ json: { ...input, Decision: decision, 'Reviewer Name': reviewer, 'Review Feedback': feedback, testCaseReview: { decision, reviewer, feedback, submittedAt: new Date().toISOString() } } }];"
      },
