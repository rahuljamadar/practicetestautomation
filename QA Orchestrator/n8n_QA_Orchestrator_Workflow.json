{
  "name": "QA Orchestrator - Enterprise Requirement to QA Package",
  "nodes": [
    {
      "parameters": {
        "public": true,
        "initialMessages": "Paste a CRS, BRD, Jira ID, User Story, or requirement text.",
        "options": {}
      },
      "id": "chat_trigger_requirement_input",
      "name": "Chat Trigger - Requirement Input",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "webhookId": "qa-orchestrator-chat-trigger"
    },
    {
      "parameters": {
        "jsCode": "const input = $json.chatInput ?? $json.requirement ?? $json.text ?? '';\n\nreturn [{\n  json: {\n    requirement: String(input).trim(),\n    requestId: `QA-${Date.now()}` ,\n    receivedAt: new Date().toISOString(),\n    requestedStages: ['Requirement Analysis', 'Test Plan', 'Manual Test Cases', 'Automation']\n  }\n}];"
      },
      "id": "normalize_requirement",
      "name": "Normalize Requirement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.requirement }}",
        "options": {
          "systemMessage": "You are the QA Orchestrator for an enterprise software team.\\n\\nYour job is to transform a CRS, BRD, user story, Jira ticket, acceptance criteria, or defect description into a complete QA package.\\n\\nStrict anti-hallucination rules:\\n- Never invent business behavior, fields, APIs, permissions, database tables, selectors, or acceptance criteria not supported by the requirement.\\n- Separate confirmed facts from assumptions and unknowns.\\n- If unclear or incomplete, ask clarifying questions instead of guessing.\\n- If missing info exists, mark it as TBD.\\n- Keep traceability to the original requirement.\\n- Do not claim execution proof without provided evidence.\\n\\nUse the RICEPOT framework: Role, Instruction, Context, Example, Parameters, Output, Tone.\\n\\nReturn valid JSON only.\\n\\nOUTPUT:\\n{\\n  \\\"request_id\\\": \\\"\\\",\\n  \\\"requirement_id\\\": \\\"\\\",\\n  \\\"title\\\": \\\"\\\",\\n  \\\"requirement_summary\\\": \\\"\\\",\\n  \\\"source_type\\\": \\\"CRS|BRD|User Story|Jira|Defect|Other\\\",\\n  \\\"facts\\\": [],\\n  \\\"assumptions\\\": [],\\n  \\\"clarification_questions\\\": [],\\n  \\\"impacted_areas\\\": [],\\n  \\\"scope\\\": {\\\"in_scope\\\": [], \\\"out_of_scope\\\": []},\\n  \\\"acceptance_criteria\\\": [],\\n  \\\"risks\\\": [],\\n  \\\"next_stage\\\": \\\"TEST_PLAN\\\"\\n}"
        }
      },
      "id": "qa_orchestrator_agent",
      "name": "QA Orchestrator Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "model": "qwen3:1.7b",
        "options": {
          "temperature": 0.1
        }
      },
      "id": "ollama_orchestrator",
      "name": "Ollama - Orchestrator (Qwen3 1.7B)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1.2,
      "position": [
        440,
        260
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json) }}",
        "options": {
          "systemMessage": "You are a Senior QA Test Plan Agent.\\n\\nCreate a production-quality Test Plan from the approved requirement.\\n\\nRules:\\n- Do not invent unsupported behavior.\\n- Mark unknowns as TBD and add clarification questions.\\n- Use P1/P2/P3 priority only when justified.\\n- Keep the plan executable by a QA team.\\n- Return valid JSON only.\\n\\nOUTPUT:\\n{\\n  \\\"test_plan\\\": {\\n    \\\"objective\\\": \\\"\\\",\\n    \\\"summary\\\": \\\"\\\",\\n    \\\"scope\\\": {\\\"in_scope\\\": [], \\\"out_of_scope\\\": []},\\n    \\\"business_rules\\\": [],\\n    \\\"acceptance_criteria\\\": [],\\n    \\\"strategy\\\": \\\"\\\",\\n    \\\"test_types\\\": [],\\n    \\\"test_data\\\": [],\\n    \\\"environment\\\": {},\\n    \\\"automation_candidates\\\": [],\\n    \\\"risks\\\": [],\\n    \\\"entry_criteria\\\": [],\\n    \\\"exit_criteria\\\": []\\n  },\\n  \\\"traceability\\\": [],\\n  \\\"clarifications\\\": [],\\n  \\\"status\\\": \\\"READY_FOR_HUMAN_REVIEW\\\"\\n}"
        }
      },
      "id": "test_plan_agent",
      "name": "Test Plan Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        700,
        0
      ]
    },
    {
      "parameters": {
        "model": "qwen3:1.7b",
        "options": {
          "temperature": 0.1
        }
      },
      "id": "ollama_test_plan",
      "name": "Ollama - Test Plan (Qwen3 1.7B)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1.2,
      "position": [
        700,
        260
      ]
    },
    {
      "parameters": {
        "resume": "form",
        "formTitle": "QA Orchestrator - Test Plan Review",
        "formDescription": "Approve or reject the generated Test Plan before continuing.",
        "formFields": {
          "values": [
            {
              "fieldType": "string",
              "name": "Reviewer Name",
              "label": "Reviewer Name",
              "placeholder": "Enter reviewer name",
              "requiredField": true
            },
            {
              "fieldType": "options",
              "name": "Decision",
              "label": "Decision",
              "options": [
                {
                  "name": "Approved",
                  "value": "approved"
                },
                {
                  "name": "Rejected",
                  "value": "rejected"
                }
              ],
              "requiredField": true
            },
            {
              "fieldType": "string",
              "name": "Review Feedback",
              "label": "Review Feedback",
              "placeholder": "Add review comments",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "webhookSuffix": "test-plan-review"
        }
      },
