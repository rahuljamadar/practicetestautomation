# Secrets and local state must never enter the deployment bundle
.env*
.venv/
.vercel_python_packages/
storage/
qabuddy.db
*.log
.vercel/

# Local-only data and heavy dependencies (seeded at deploy time)
data/
frontend/node_modules/
frontend/dist/
node_modules/
**/node_modules/

# Python junk
__pycache__/
**/__pycache__/
*.pyc
