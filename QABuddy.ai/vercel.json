{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/**/*.py": {
      "memory": 1024,
      "maxDuration": 60,
      "excludeFiles": "{frontend/node_modules/**,backend/.venv/**,backend/tests/**,.vercel_python_packages/**,storage/**,**/__pycache__/**,**/*.pyc,*.log}"
    }
  }
}
