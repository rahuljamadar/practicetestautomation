{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Screenshot Bug Report",
  "type": "object",
  "required": ["title", "summary", "steps_to_reproduce", "expected_result", "actual_result", "environment", "severity", "priority", "labels", "confidence", "assumptions"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "steps_to_reproduce": {"type": "array", "items": {"type": "string"}},
    "expected_result": {"type": "string", "minLength": 1},
    "actual_result": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "severity": {"enum": ["blocker", "critical", "major", "minor", "trivial"]},
    "priority": {"enum": ["highest", "high", "medium", "low", "lowest"]},
    "labels": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}}
  }
}
